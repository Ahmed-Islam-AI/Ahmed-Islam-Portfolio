{
  // The build-side files run in Node, not the browser, so they get Node's types
  // and the app's tsconfig does not: `process` and friends stay out of src/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "blog.vite.ts", "src/content/types.ts"]
}
